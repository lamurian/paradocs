{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "declaration": false,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "extensions/**/*.ts",
    "extensions/**/*.d.ts",
    "common/**/*.ts",
    "types/**/*.d.ts",
    "tests/**/*.ts",
    "scripts/**/*.mjs"
  ],
  "exclude": [
    "node_modules"
  ]
}
